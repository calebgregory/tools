{
  "permissions": {
    "allow": [
      "Bash(obsidian-cli *)",
      "Bash(relative-dates:*)",
      "Bash(transcribe:*)",
      "Read(~/_/main/**/todo.md)",
      "Read(~/_/main/*/todo.md)",
      "Read(~/_/main/**/contact.md)",
      "Read(~/_/main/*/contact.md)",
      "Read(~/work/ds-monorepo)",
      "Read(~/work/ds-monorepo-wt/*)",
      "Read(~/work/notes/*)",
      "Read(~/tools/claude/work-org/memory/*)"
    ]
  },
  "model": "fable",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid-claude-statusline write-last-message-time"
          },
          {
            "type": "command",
            "command": "lemonaid claude submit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid claude notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid claude waiter-check"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid claude notify"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid claude notify"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid claude session-start"
          },
          {
            "type": "command",
            "command": "$HOME/tools/claude/global/theme-follow-system.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid hooks session-start --harness claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=$(cat); v() { printf \"%s\" \"$d\" | tr \",{\" \"\\n\\n\" | sed -n \"s/^ *\\\"$1\\\" *: *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | sort -u; }; s=$(v session_id | head -n1); w=\"${LEMONAID_STATE_DIR:-$HOME/.local/state/lemonaid}/own-edits/claude-$s\"; [ -n \"$s\" ] && [ -d \"$w\" ] || exit 0; set -- \"$w\"/*.doc; [ -e \"$w/brief\" ] || [ -e \"$1\" ] || case \"$d\" in *git*push*) ;; *) exit 0 ;; esac; printf \"%s\" \"$d\" | exec lemonaid hooks own-change --harness claude'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=$(cat); v() { printf \"%s\" \"$d\" | tr \",{\" \"\\n\\n\" | sed -n \"s/^ *\\\"$1\\\" *: *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | sort -u; }; s=$(v session_id | head -n1); w=\"${LEMONAID_STATE_DIR:-$HOME/.local/state/lemonaid}/own-edits/claude-$s\"; [ -n \"$s\" ] && [ -d \"$w\" ] || exit 0; set -- \"$w\"/*.doc; [ -e \"$w/brief\" ] || [ -e \"$1\" ] || case \"$d\" in *git*push*) ;; *) exit 0 ;; esac; printf \"%s\" \"$d\" | exec lemonaid hooks own-change --harness claude'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemonaid claude session-end"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "lemonaid-claude-statusline"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "datadog@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "…"
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "custom:system",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "voiceEnabled": true
}
